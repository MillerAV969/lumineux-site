{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "startCommand": "node -e \"if(process.env.DISABLE_RUNTIME==='1'){const http=require('http');const p=Number(process.env.PORT||3000);const s=http.createServer((q,r)=>{r.statusCode=200;r.end('disabled');});s.listen(p,()=>setTimeout(()=>s.close(()=>process.exit(0)),60000));}else{require('./server.js');}\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
